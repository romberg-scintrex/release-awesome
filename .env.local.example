NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for the username availability check and for resolving a
# tenant's verified email on their contact form. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media

# Email. CONTACT_FROM_EMAIL is REQUIRED and must be an address on a domain you
# have verified in Resend: the onboarding@resend.dev sender only delivers to the
# Resend account owner and returns 403 for anyone else, so without a verified
# domain every tenant's contact form fails.
RESEND_API_KEY=your-resend-api-key
CONTACT_FROM_EMAIL=Portfolio <noreply@yourdomain.com>
# Recipient for the PLATFORM-level form at /contact only. A tenant's form
# resolves that tenant's own verified auth.users.email and never falls back
# here - see .claude/specs/platform-homepage-signup/design.md D5.
CONTACT_TO_EMAIL=you@example.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token
TELEGRAM_CHAT_ID=123456789

NEXT_PUBLIC_SITE_URL=https://release-awesome.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token
