import type { Metadata } from "next";
import { notFound } from "next/navigation";
import Link from "next/link";
import {
  MapPin,
  GraduationCap,
  Mail,
  Download,
  ArrowUpRight,
  ExternalLink,
} from "lucide-react";
import { getProfileByUsername, getProjectsByUsername } from "@/lib/queries-by-user";
import { SITE } from "@/lib/utils";
import { GithubIcon, LinkedinIcon, FacebookIcon, InstagramIcon } from "@/components/Elements/Icons";
import type { Profile, Project } from "@/lib/types";

// ── ISR: revalidate every 60 s, statically rendered ──────────────────────────
export const revalidate = 60;
export const dynamic = "force-static";

// ── generateMetadata ──────────────────────────────────────────────────────────

export async function generateMetadata({
  params,
}: {
  params: Promise<{ username: string }>;
}): Promise<Metadata> {
  const { username } = await params;
  const profile = await getProfileByUsername(username);

  // notFound() will handle the null case in the page component;
  // here we return minimal metadata so Next.js can still render a 404.
  if (!profile) return {};

  const canonicalUrl = `${SITE.url}/${username}`;

  return {
    title: `${profile.name} – ${profile.role}`,
    description: profile.description,
    alternates: { canonical: canonicalUrl },
    openGraph: {
      title: `${profile.name} – ${profile.role}`,
      description: profile.description,
      url: canonicalUrl,
    },
  };
}

// ── Sub-components ────────────────────────────────────────────────────────────

function SocialLink({
  href,
  label,
  children,
}: {
  href: string;
  label: string;
  children: React.ReactNode;
}) {
  if (!href) return null;
  return (
    <a
      href={href}
      target="_blank"
      rel="noreferrer noopener"
      aria-label={label}
      className="inline-flex h-10 w-10 items-center justify-center rounded-full border border-black/10 dark:border-white/10 text-ink-500 dark:text-ink-400 hover:text-ink-950 dark:hover:text-white hover:border-black/20 dark:hover:border-white/20 transition-colors"
    >
      {children}
    </a>
  );
}

function TechBadge({ tech }: { tech: string }) {
  return (
    <span className="inline-flex items-center rounded-full border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-3 py-1 text-xs font-mono text-ink-500 dark:text-ink-400">
      {tech}
    </span>
  );
}

function ProjectCard({ project }: { project: Project }) {
  return (
    <article
      className="group flex flex-col rounded-2xl border border-black/10 dark:border-white/10 bg-[rgb(var(--card))] overflow-hidden hover:border-black/20 dark:hover:border-white/20 transition-colors"
      aria-label={project.title}
    >
      {/* Gradient top band */}
      <div
        className="h-1.5 w-full"
        style={{ background: project.gradient || "linear-gradient(to right, #059669, #34d399)" }}
        aria-hidden="true"
      />

      <div className="flex flex-col gap-4 p-6 flex-1">
        {/* Header row */}
        <div className="flex items-start justify-between gap-3">
          <div className="flex-1 min-w-0">
            <h3 className="font-display text-lg font-semibold tracking-tight text-[rgb(var(--fg))] group-hover:text-[rgb(var(--accent))] transition-colors truncate">
              {project.title}
            </h3>
            <p className="mt-0.5 text-xs font-mono text-ink-400 tabular-nums">
              {project.year}
              {project.categories.length > 0 && (
                <>
                  {" "}
                  ·{" "}
                  {project.categories.join(", ")}
                </>
              )}
            </p>
          </div>

          {/* External links */}
          <div className="flex items-center gap-1.5 shrink-0">
            {project.githubURL && (
              <a
                href={project.githubURL}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${project.title} on GitHub`}
                className="flex h-8 w-8 items-center justify-center rounded-lg text-ink-400 hover:text-ink-950 dark:hover:text-white transition-colors"
              >
                <GithubIcon size={15} aria-hidden="true" />
              </a>
            )}
            {project.liveURL && (
              <a
                href={project.liveURL}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${project.title} live demo`}
                className="flex h-8 w-8 items-center justify-center rounded-lg text-ink-400 hover:text-ink-950 dark:hover:text-white transition-colors"
              >
                <ExternalLink size={15} aria-hidden="true" />
              </a>
            )}
          </div>
        </div>

        {/* Short description */}
        <p className="text-sm text-ink-400 leading-relaxed line-clamp-3 flex-1">
          {project.shortDescription}
        </p>

        {/* Tech stack badges */}
        {project.technologies.length > 0 && (
          <div className="flex flex-wrap gap-1.5 mt-auto pt-2">
            {project.technologies.slice(0, 5).map((tech) => (
              <TechBadge key={tech} tech={tech} />
            ))}
            {project.technologies.length > 5 && (
              <span className="inline-flex items-center rounded-full border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 px-3 py-1 text-xs font-mono text-ink-400">
                +{project.technologies.length - 5}
              </span>
            )}
          </div>
        )}
      </div>
    </article>
  );
}

function TenantHero({ profile }: { profile: Profile }) {
  return (
    <section
      aria-label={`${profile.name} – hero`}
      className="relative min-h-[85vh] flex items-end overflow-hidden bg-[rgb(var(--bg))]"
    >
      {/* Background image */}
      {profile.heroBackURL && (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={profile.heroBackURL}
          alt=""
          aria-hidden="true"
          className="absolute inset-0 h-full w-full object-cover object-center pointer-events-none select-none"
          fetchPriority="high"
        />
      )}

      {/* Scrim overlay */}
      <div
        aria-hidden="true"
        className="absolute inset-0 bg-gradient-to-t from-[rgb(var(--bg))] via-[rgb(var(--bg)/0.55)] to-transparent"
      />

      {/* Foreground portrait */}
      {profile.heroFrontURL && (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={profile.heroFrontURL}
          alt={`${profile.name} portrait`}
          className="absolute bottom-0 right-4 md:right-12 lg:right-24 h-[70%] max-h-[560px] w-auto object-contain object-bottom pointer-events-none select-none z-10"
          fetchPriority="high"
        />
      )}

      {/* Hero content rail */}
      <div className="container relative z-20 pb-16 pt-32 md:pb-24">
        <div className="max-w-xl">
          {/* Eyebrow */}
          <p className="mb-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[rgb(var(--accent))]">
            Portfolio
          </p>

          {/* Name */}
          <h1 className="font-display text-fluid-h1 font-bold tracking-tight text-[rgb(var(--fg))] leading-[1.05]">
            {profile.name}
          </h1>

          {/* Role */}
          <p className="mt-3 text-xl font-medium text-ink-400 dark:text-ink-300">
            {profile.role}
          </p>

          {/* University & Location */}
          <div className="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-400">
            {profile.university && (
              <span className="inline-flex items-center gap-1.5">
                <GraduationCap size={14} aria-hidden="true" />
                {profile.university}
              </span>
            )}
            {profile.location && (
              <span className="inline-flex items-center gap-1.5">
                <MapPin size={14} aria-hidden="true" />
                {profile.location}
              </span>
            )}
          </div>

          {/* Bio */}
          {profile.description && (
            <p className="mt-5 text-base text-ink-400 leading-relaxed max-w-lg">
              {profile.description}
            </p>
          )}

          {/* CTA row */}
          <div className="mt-7 flex flex-wrap items-center gap-3">
            {/* Contact */}
            <a
              href={`mailto:${profile.email}`}
              className="btn-sheen inline-flex h-11 items-center gap-2 rounded-full bg-[rgb(var(--fg))] px-6 text-sm font-medium text-[rgb(var(--bg))] transition-opacity hover:opacity-90"
            >
              <Mail size={16} aria-hidden="true" />
              Contact
            </a>

            {/* CV download */}
            {profile.cvURL && (
              <a
                href={profile.cvURL}
                target="_blank"
                rel="noreferrer noopener"
                download
                className="inline-flex h-11 items-center gap-2 rounded-full border border-black/15 dark:border-white/15 px-6 text-sm font-medium text-[rgb(var(--fg))] hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              >
                <Download size={16} aria-hidden="true" />
                Download CV
              </a>
            )}
          </div>

          {/* Social icons */}
          <div className="mt-6 flex items-center gap-2" aria-label="Social links">
            {profile.social.github && (
              <SocialLink href={profile.social.github} label="GitHub">
                <GithubIcon size={16} />
              </SocialLink>
            )}
            {profile.social.linkedin && (
              <SocialLink href={profile.social.linkedin} label="LinkedIn">
                <LinkedinIcon size={16} />
              </SocialLink>
            )}
            {profile.social.facebook && (
              <SocialLink href={profile.social.facebook} label="Facebook">
                <FacebookIcon size={16} />
              </SocialLink>
            )}
            {profile.social.instagram && (
              <SocialLink href={profile.social.instagram} label="Instagram">
                <InstagramIcon size={16} />
              </SocialLink>
            )}
          </div>
        </div>
      </div>
    </section>
  );
}

function ProjectsSection({
  projects,
  username,
}: {
  projects: Project[];
  username: string;
}) {
  if (projects.length === 0) return null;

  return (
    <section aria-label="Projects" className="container py-20 sm:py-28">
      {/* Section header */}
      <div className="mb-12">
        <div className="mb-4 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-400">
          <span className="tabular-nums text-[rgb(var(--fg))]">01</span>
          <span className="h-px w-7 bg-ink-300 dark:bg-ink-700" aria-hidden="true" />
          Work
        </div>
        <h2 className="font-display text-fluid-h2 font-semibold tracking-tight text-[rgb(var(--fg))]">
          Selected Projects
        </h2>
        <p className="mt-3 max-w-xl text-base text-ink-400">
          A selection of work — products, experiments, and tools built to solve real problems.
        </p>
      </div>

      {/* Grid */}
      <div className="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard key={project.id} project={project} />
        ))}
      </div>

      {/* Contact CTA */}
      <div className="mt-16 flex flex-col items-center gap-4 text-center border-t border-black/10 dark:border-white/10 pt-16">
        <p className="text-sm font-mono uppercase tracking-[0.18em] text-ink-400">
          Have a project in mind?
        </p>
        <Link
          href={`/${username}/contact`}
          className="group inline-flex items-center gap-2 font-display text-2xl font-semibold text-[rgb(var(--fg))] hover:text-[rgb(var(--accent))] transition-colors"
        >
          Let&apos;s work together
          <ArrowUpRight
            size={24}
            className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </Link>
      </div>
    </section>
  );
}

// ── Page component ────────────────────────────────────────────────────────────

export default async function TenantHomePage({
  params,
}: {
  params: Promise<{ username: string }>;
}) {
  const { username } = await params;

  // Parallel fetch; getProfileByUsername is React.cache'd so generateMetadata
  // call above won't trigger a second DB round-trip.
  const [profile, projects] = await Promise.all([
    getProfileByUsername(username),
    getProjectsByUsername(username),
  ]);

  if (!profile) notFound();

  return (
    <main className="page-enter" aria-label={`${profile.name} portfolio`}>
      <TenantHero profile={profile} />
      <ProjectsSection projects={projects} username={username} />
    </main>
  );
}
